{
	"$schema": "./node_modules/@edgestation/sdk/manifest.schema.json",
	"name": "Pomodoro",
	"version": "1.0.0",
	"description": "A focus timer that alternates work sessions and breaks.",
	"author": "ChainList",
	"minAppVersion": "0.1.0",
	"main": "dist/main.js",
	"icon": "icon.svg",
	"size": {
		"w": 2,
		"h": 1
	},
	"settings": [
		{
			"key": "focus",
			"label": "Focus length",
			"type": "select",
			"default": "25",
			"options": [
				{
					"value": "15",
					"label": "15 minutes"
				},
				{
					"value": "25",
					"label": "25 minutes"
				},
				{
					"value": "45",
					"label": "45 minutes"
				},
				{
					"value": "50",
					"label": "50 minutes"
				}
			]
		},
		{
			"key": "break",
			"label": "Break length",
			"type": "select",
			"default": "5",
			"options": [
				{
					"value": "5",
					"label": "5 minutes"
				},
				{
					"value": "10",
					"label": "10 minutes"
				},
				{
					"value": "15",
					"label": "15 minutes"
				}
			]
		}
	]
}
